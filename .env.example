# ============================================================
#  复制本文件为 .env 后修改。默认 provider=mock 时无需任何 key。
# ============================================================

# 可选值: mock | deepseek | qwen | zhipu | doubao | ollama | custom
# mock 使用内置的假模型，不联网，用来跑通链路和演示。
LLM_PROVIDER=mock

# 只有 provider=custom 或需要覆盖预设时才填
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 各家 API Key（按你选的 provider 填一个即可）
LLM_API_KEY=

# 采样温度：审核场景必须为 0，保证结果可复现
LLM_TEMPERATURE=0

# 单次请求超时（秒）与失败重试次数
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# 低于该置信度的判定会自动转人工复核
AUDIT_CONFIDENCE_THRESHOLD=0.7

# 规则文件路径（相对项目根目录）
RULES_PATH=config/rules.yaml

# 审计日志目录
LOG_DIR=logs
